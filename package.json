{
    "name": "workbench",
    "version": "2.0.1",
    "scripts": {
        "start:dev:extension": "rm -rf dist/extension; npm-run-all --parallel watch:extension serve:extension",
        "start:dev:server": "npm run build:server && NODE_ENV=development DOTENV_CONFIG_PATH=.env.dev node -r dotenv/config packages/server/dist/server-dev.js",
        "start:dev:desktop": "npm --prefix packages/desktop run start:dev",
        "start:dev:vscode": "npm --prefix packages/vscode run start",
        "site:dev": "npm-run-all --parallel ui:dev docs:dev",
        "build:prod:extension": "rm -rf dist/extension; npm run build:shared; npm run build:vendor:just-bash; rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:production; rollup -c tools/build/rollup.workers.mjs --bundleConfigAsCjs --environment NODE_ENV:production",
        "build:extension": "rm -rf dist/extension; npm run build:shared; npm run build:vendor:just-bash; rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:production,BUNDLE_TARGET:all",
        "build:server": "tsc -p packages/server/tsconfig.json",
        "build:desktop": "npm --prefix packages/desktop run build",
        "build:workers": "npm run build:shared && rollup -c tools/build/rollup.workers.mjs --bundleConfigAsCjs --environment NODE_ENV:production",
        "build:shared": "node tools/scripts/generate_manifest_skill.js && node tools/scripts/generate_application_manifest.js && tsc -p packages/lwc/shared/tsconfig.json",
        "site:build": "npm-run-all ui:build docs:build",
        "build:all": "npm-run-all site:build build:workers build:extension build:desktop",
        "lint": "npm run lint:eslint && npm run format:check",
        "format": "prettier --write \"{packages,tools}/**/*.{js,jsx,ts,tsx,json,css,scss,html,mjs}\"",
        "format:check": "prettier --check \"{packages,tools}/**/*.{js,jsx,ts,tsx,json,css,scss,html,mjs}\"",
        "lint:eslint": "eslint \"{packages,tools}/**/*.{js,jsx,ts,tsx,mjs}\"",
        "lint:eslint:fix": "eslint \"{packages,tools}/**/*.{js,jsx,ts,tsx,mjs}\" --fix",
        "test": "node --experimental-strip-types --import=./tools/testing/register.mjs --test \"packages/lwc/shared/**/__tests__/*.test.@(ts|js|mjs)\" \"packages/lwc/main/**/__tests__/*.test.@(ts|js|mjs)\" \"packages/lwc/applications/**/__tests__/*.test.@(ts|js|mjs)\" \"packages/lwc/extension/**/__tests__/*.test.@(ts|js|mjs)\" \"packages/server/**/__tests__/*.test.@(ts|js|mjs)\" \"packages/extension/**/__tests__/*.test.@(ts|js|mjs)\" \"tools/testing/**/__tests__/*.test.@(ts|js|mjs)\"",
        "test:e2e:smoke": "node -e \"if(process.env.E2E!=='1'){console.log('E2E disabled; set E2E=1 to run.');process.exit(0)}require('child_process').execSync('npx --no-install playwright test -c packages/tests-e2e/playwright.config.ts --project=smoke',{stdio:'inherit'})\"",
        "test:e2e:ext": "E2E=1 npx --no-install playwright test -c packages/tests-e2e/playwright.config.ts --project=extension",
        "test:e2e:serve": "node tools/scripts/e2e_serve.mjs",
        "validate": "npm-run-all lint test build:all",
        "start:prod:server": "npm run build:server && NODE_ENV=production DOTENV_CONFIG_PATH=.env.prod node -r dotenv/config packages/server/dist/server-prod.js",
        "start:dev:extension:main": "rm -rf dist/extension; npm-run-all --parallel watch:extension:main serve:extension",
        "start:dev:extension:sandbox": "npm-run-all --parallel watch:extension:sandbox serve:extension",
        "start:dev:extension:vscode": "npm-run-all --parallel watch:extension start:dev:vscode",
        "start:dev:desktop:all": "npm-run-all --parallel watch:extension start:dev:desktop",
        "start:dev:vscode:debug": "npm --prefix packages/vscode run start:debug",
        "start:dev:server:full": "npm-run-all --parallel watch:shared start:dev:server start:dev:vscode",
        "build:extension:main": "rm -rf dist/extension; npm run build:shared; npm run build:vendor:just-bash; rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:production,BUNDLE_TARGET:main",
        "build:extension:sandbox": "mkdir -p dist/extension/scripts && npm run build:shared && rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:production,BUNDLE_TARGET:sandbox",
        "build:vendor": "npm-run-all build:vendor:just-bash",
        "build:vendor:just-bash": "cd vendor-bundles/just-bash && npm install && npm run build && cp dist/* ../../assets/extension/libs/just-bash/",
        "ui:dev": "npm --prefix apps/ui run dev",
        "docs:dev": "npm --prefix apps/docs run dev",
        "ui:build": "UI_BASE_PATH=/welcome/ npm --prefix apps/ui run build",
        "docs:build": "npm --prefix apps/docs run build",
        "ui:install": "npm --prefix apps/ui install",
        "docs:install": "npm --prefix apps/docs install",
        "site:install": "npm-run-all ui:install docs:install",
        "watch:shared": "node tools/scripts/generate_manifest_skill.js && node tools/scripts/generate_application_manifest.js && tsc -p packages/lwc/shared/tsconfig.json --watch",
        "watch:extension": "npm-run-all --parallel watch:shared watch:extension:rollup",
        "watch:extension:rollup": "npm run build:vendor:just-bash && rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:development,BUNDLE_TARGET:all --watch --watch.buildDelay 3000 --logLevel error",
        "watch:extension:main": "npm-run-all --parallel watch:shared watch:extension:main:rollup",
        "watch:extension:main:rollup": "npm run build:vendor:just-bash && rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:development,BUNDLE_TARGET:main --watch --watch.buildDelay 3000 --logLevel error",
        "watch:extension:sandbox": "npm-run-all --parallel watch:shared watch:extension:sandbox:rollup",
        "watch:extension:sandbox:rollup": "mkdir -p dist/extension/scripts && rollup -c tools/build/rollup.extension.mjs --bundleConfigAsCjs --environment NODE_ENV:development,BUNDLE_TARGET:sandbox --watch --watch.buildDelay 3000 --logLevel error",
        "watch:workers": "npm-run-all --parallel watch:shared watch:workers:rollup",
        "watch:workers:rollup": "rollup -c tools/build/rollup.workers.mjs --bundleConfigAsCjs --environment NODE_ENV:development --watch --watch.buildDelay 3000 --logLevel error",
        "serve:extension": "serve dist/extension",
        "package:desktop": "npm --prefix packages/desktop run package",
        "make:desktop": "npm --prefix packages/desktop run make",
        "desktop:open": "npm --prefix packages/desktop run cli",
        "generate:skills-manifest": "node tools/scripts/generate_manifest_skill.js",
        "generate:application-manifest": "node tools/scripts/generate_application_manifest.js",
        "generate:lucide-icons": "node tools/scripts/generate_lucide_icons.mjs",
        "generate:docs:salesforce": "node tools/scripts/load_documentation.js",
        "fix:lightning": "node tools/scripts/fix_lightning.js",
        "sync:soql-extension-assets": "node tools/scripts/sync_soql_extension_assets.mjs",
        "start:test:mcp": "node tools/mcp/basic-mcp-server.mjs",
        "test:mcp": "node tools/mcp/verify-basic-mcp.mjs",
        "test:provider:internal:streaming": "node --experimental-strip-types --import=./tools/testing/register.mjs tools/llm-provider-harness/runStreaming.ts",
        "test:provider:internal:non-streaming": "node --experimental-strip-types --import=./tools/testing/register.mjs tools/llm-provider-harness/runNonStreaming.ts",
        "test:provider:internal": "npm-run-all test:provider:internal:streaming test:provider:internal:non-streaming",
        "docker:dev": "docker compose -f docker-compose.dev.yml up",
        "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
        "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
        "docker:up": "docker compose up",
        "docker:build": "npm run docker:prebuild && docker compose build",
        "docker:prebuild": "npm-run-all build:shared build:server site:build && (cd packages/vscode && ./node_modules/.bin/vite --config vite.config.ts build)",
        "docker:dev:start": "npm-run-all --parallel watch:shared docker:dev:start:server ui:dev docs:dev start:dev:vscode",
        "docker:dev:start:server": "npm run build:server; NODE_ENV=development DOTENV_CONFIG_PATH=.env.dev node -r dotenv/config packages/server/dist/server-dev.js",
        "start:heroku": "npm run build:server && NODE_ENV=production DOTENV_CONFIG_PATH=.env.prod node -r dotenv/config packages/server/dist/server-prod.js",
        "heroku-postbuild": "npm run site:build",
        "postinstall": "node tools/scripts/patch_lwr_hmr_namespace.mjs; [ -z \"$DOCKER_DEV\" ] && npm --prefix packages/desktop install || true"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/dist/extension"
                ]
            }
        }
    },
    "copyFiles": [
        {
            "from": "node_modules/@salesforce-ux/design-system/assets",
            "to": "assets/extension"
        },
        {
            "from": "node_modules/xterm/css/xterm.css",
            "to": "assets/extension/styles"
        }
    ],
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.68",
        "@ai-sdk/google": "^3.0.60",
        "@ai-sdk/mcp": "^1.0.36",
        "@ai-sdk/openai": "^3.0.41",
        "@ai-sdk/openai-compatible": "^2.0.42",
        "@ai-sdk/xai": "^3.0.80",
        "@jetstreamapp/soql-parser-js": "^6.2.4",
        "@lwc/synthetic-shadow": "^9.1.1",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@reduxjs/toolkit": "^2.8.2",
        "@salesforce-ux/design-system": "2.27.2",
        "@salesforce/source-deploy-retrieve": "^12.32.4",
        "@webcomponents/custom-elements": "^1.6.0",
        "ai": "^6.0.116",
        "chromium-bidi": "^15.0.0",
        "cometd": "^7.0.12",
        "diff": "^7.0.0",
        "dotenv": "^16.3.1",
        "express": "^5.1.0",
        "fflate": "^0.8.2",
        "flexsearch": "^0.8.205",
        "highlight.js": "^11.9.0",
        "hotkeys-js": "3.13.7",
        "js-yaml": "^4.1.0",
        "jsforce": "^3.4.1",
        "just-bash": "^2.12.8",
        "lightning-base-components": "^1.22.2-alpha",
        "localforage-webextensionstorage-driver": "^3.0.0",
        "mermaid": "^11.10.1",
        "moment": "^2.30.1",
        "monacopilot": "1.2.7",
        "node-fetch": "^2.7.0",
        "node-schedule": "^2.1.1",
        "openai": "^6.25.0",
        "openapi-sampler": "^1.6.1",
        "papaparse": "^5.5.3",
        "puppeteer-core": "^24.39.0",
        "qs": "^6.11.2",
        "redux": "^4.0.5",
        "redux-thunk": "^2.3.0",
        "request": "2.88.2",
        "serve": "^14.2.1",
        "serve-static": "^1.15.0",
        "tabulator-tables": "6.2.1",
        "xml2js": "^0.6.2",
        "xterm": "^5.3.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@babel/core": "^7.29.0",
        "@babel/plugin-syntax-decorators": "^7.28.6",
        "@babel/plugin-transform-typescript": "^7.28.6",
        "@babel/preset-env": "^7.28.3",
        "@babel/runtime": "^7.28.3",
        "@lwc/rollup-plugin": "^9.1.1",
        "@lwrjs/client-modules": "^0.23.3",
        "@lwrjs/router": "^0.23.3",
        "@playwright/test": "^1.59.1",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^26.0.1",
        "@rollup/plugin-inject": "^5.0.5",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.7",
        "@rollup/plugin-sucrase": "^5.1.0",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.3.0",
        "@salesforce-ux/eslint-plugin-slds": "^1.1.0",
        "@salesforce/core": "^6.7.6",
        "@types/d3-dispatch": "^3.0.4",
        "@types/express-serve-static-core": "^4.19.8",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@typescript-eslint/parser": "^8.58.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "lucide-static": "^1.7.0",
        "lwc": "^9.1.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-polyfill-node": "^0.13.0",
        "serve-handler": "^6.1.6",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@lwc/compiler": "9.1.1",
        "@lwc/babel-plugin-component": "9.1.1"
    }
}
