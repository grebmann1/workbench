{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "strict": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "shared/llm": ["../lwc/shared/modules/llm/llm.ts"],
      "shared/cacheManager": ["../lwc/shared/modules/cacheManager/cacheManager.ts"],
      "vscode/metadataApi": ["./src/shared/metadataApi/metadataApi.ts"],
      "vscode/sourceTracking": ["./src/shared/sourceTracking/sourceTracking.ts"],
      "vscode/toolingApi": ["./src/shared/toolingApi/toolingApi.ts"],
      "vscode/bridge/iframeFsBridgeContract": ["../lwc/main/vscode/fullApp/bridge/iframeFsBridgeContract.ts"],
      "vscode/bridge/iframeFsBridgeClient": ["../lwc/main/vscode/fullApp/bridge/iframeFsBridgeClient.ts"],
      "vscode/bridge/bootstrapIframeBridge": ["../lwc/main/vscode/fullApp/bridge/bootstrapIframeBridge.ts"],
      "vscode/bridge/iframeJsforceBridgeContract": ["../lwc/main/vscode/fullApp/bridge/iframeJsforceBridgeContract.ts"],
      "vscode/bridge/bootstrapIframeJsforceBridge": ["../lwc/main/vscode/fullApp/bridge/bootstrapIframeJsforceBridge.ts"],
      "vscode/bridge/iframeJsforceBridgeClient": ["../lwc/main/vscode/fullApp/bridge/iframeJsforceBridgeClient.ts"],
      "vscode/bridge/iframeAiBridgeContract": ["../lwc/main/vscode/fullApp/bridge/iframeAiBridgeContract.ts"],
      "vscode/bridge/bootstrapIframeAiBridge": ["../lwc/main/vscode/fullApp/bridge/bootstrapIframeAiBridge.ts"],
      "vscode/bridge/iframeAiBridgeClient": ["../lwc/main/vscode/fullApp/bridge/iframeAiBridgeClient.ts"],
      "vscode/bridge/registerIframeWorkspaceProvider": ["src/workbench/bridge/registerIframeWorkspaceProvider.ts"],
      "vscode/fullApp/bootstrapState": ["../lwc/main/vscode/fullApp/bootstrapState.ts"],
      "vscode/vscode/*": ["../dist/main/vscode/src/*"],
      "vscode/*": ["../dist/main/*"]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/types.d.ts",
    "src/entry.ts",
    "src/loader.ts",
    "src/main.common.ts",
    "src/main.workbench.ts",
    "src/setup.common.ts",
    "src/setup.workbench.ts",
    "src/shared/**/*.ts",
    "src/workbench/**/*.ts"
  ]
}
