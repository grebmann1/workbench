{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "lib": ["ES2020", "DOM"],
        "baseUrl": ".",
        "paths": {
            "shared/*": ["../lwc/shared/modules/*"],
            "shared/analytics": ["../lwc/shared/modules/analytics/analytics"],
            "shared/llm": ["../lwc/shared/modules/llm/llm"],
            "shared/loader": ["../lwc/shared/modules/loader/loader"],
            "shared/markdown": ["../lwc/shared/modules/markdown/markdown"],
            "shared/sf": ["../lwc/shared/modules/sf/sf"]
        },
        "rootDir": ".",
        "outDir": "./dist",
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": ["**/*.ts", "types/**/*.d.ts"],
    "exclude": ["assets", "dist", "node_modules"]
}
