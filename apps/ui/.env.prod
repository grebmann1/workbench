# Production overrides — auto-loaded by `vite build --mode prod` (see ui:build script).
# NOTE: the mode is `prod`, so this file MUST be `.env.prod` (not `.env.production`),
# otherwise Vite silently ignores it.
# Mirrors the subdomain routing in docker/nginx.conf.template.
VITE_DOCS_URL=https://doc.sf-workbench.com

# Google Analytics 4 measurement ID (shared with the extension/desktop bundles).
# Public value — safe to commit. Omit to disable analytics on the web SPA.
VITE_GA_MEASUREMENT_ID=G-J8XPLSRY91
