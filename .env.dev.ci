# .env.dev.ci — placeholder credentials used by the CI e2e-smoke job.
#
# The Express server (packages/server/server-dev.ts) loads these via
# DOTENV_CONFIG_PATH=.env.dev. For the smoke suite the values only need
# to exist — `/config` echoes them, and OAuth flows never run without a
# real `code` param. Do NOT replace with real secrets; real CLIENT_ID /
# CLIENT_SECRET values belong in repository secrets, not in the repo.
CLIENT_ID=ci-dummy
CLIENT_SECRET=ci-dummy
CHROME_ID=ci-dummy
PORT=3000
